# --- Discord (from https://discord.com/developers/applications) ---
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Optional: your server's ID. Makes /join and /leave appear instantly in that server.
DISCORD_GUILD_ID=

# --- Speech-to-text (any OpenAI-compatible /audio/transcriptions API) ---
TRANSCRIBE_API_KEY=your-api-key
# OpenAI (default):
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Groq (fast, cheap):  TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1  TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Optional ISO-639-1 language hint, e.g. en
TRANSCRIBE_LANGUAGE=

# --- Tuning (optional) ---
# Quiet time (ms) that ends someone's sentence
SILENCE_MS=1000
# Ignore clips shorter than this (ms)
MIN_CLIP_MS=700
# Split long monologues into chunks of this length (ms)
MAX_CLIP_MS=30000
