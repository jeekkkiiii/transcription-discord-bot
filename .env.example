# --- Discord (from https://discord.com/developers/applications) ---
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Optional: your server's ID. Makes /join and /leave appear instantly in that server.
DISCORD_GUILD_ID=

# --- Speech-to-text (any OpenAI-compatible /audio/transcriptions API) ---
TRANSCRIBE_API_KEY=your-api-key
# Groq — free tier, get a key at https://console.groq.com
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=whisper-large-v3-turbo
# OpenAI (paid, ~$0.18/hour of speech):
#   TRANSCRIBE_BASE_URL=https://api.openai.com/v1  TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional ISO-639-1 language hint, e.g. en
TRANSCRIBE_LANGUAGE=en
# Names and words the model should expect (helps a lot with fantasy names), comma-separated
TRANSCRIBE_PROMPT=Dungeons & Dragons session. Dungeon Master, initiative, d20, saving throw, Eldritch Blast

# --- Tuning (optional) ---
# Quiet time (ms) that ends someone's sentence
SILENCE_MS=1000
# Ignore clips shorter than this (ms)
MIN_CLIP_MS=700
# Split long monologues into chunks of this length (ms)
MAX_CLIP_MS=30000
# Group each speaker's talking into ~20s clips before transcribing, to stay inside
# free-tier request limits. Lines appear a bit later and can hold a few sentences.
# Set to 0 to send every sentence on its own.
BATCH_TARGET_MS=20000
# Never hold someone's words back longer than this (ms)
BATCH_MAX_WAIT_MS=60000

# --- Your website (optional) ---
# Emaq POSTs every transcript line here as JSON. Leave empty to only post in Discord.
WEBSITE_WEBHOOK_URL=
# Any long random string; your site uses it to verify requests (X-Emaq-Signature header)
WEBSITE_WEBHOOK_SECRET=
# Set to false to send transcripts only to the website, not the Discord channel
POST_TO_DISCORD=true
